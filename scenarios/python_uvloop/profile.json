{
  "test_name": "python_uvloop",
  "note": "Two named tasks, sequential, no gather. cpu_bound_work then io_simulation each run EXECUTION_TIME_SEC/2, so wall-time 50/50. Main is never a gather parent and never a leaf.",
  "scale_by_duration": false,
  "pprof-regex": "",
  "stacks": [
    {
      "profile-type": "wall-time",
      "pprof-regex": "",
      "stack-content": [
        {
          "regular_expression": ".*cpu_bound_work.*",
          "percent": 50,
          "error_margin": 10,
          "labels": [
            {
              "key": "task name",
              "values": [
                "cpu_task"
              ]
            }
          ]
        }
      ]
    },
    {
      "profile-type": "wall-time",
      "pprof-regex": "",
      "stack-content": [
        {
          "regular_expression": ".*io_simulation.*",
          "percent": 50,
          "error_margin": 10,
          "labels": [
            {
              "key": "task name",
              "values": [
                "io_task"
              ]
            }
          ]
        }
      ]
    }
  ]
}
