{
  "test_name": "python_gil_contention",
  "note": "cpu-time 1e9 ns/s is one core. spin-0 percent 12 is fair share 100/8. wall-time 8e9 ns/s is NUM_THREADS × 1e9. Margins sized so a different machine still passes; the anchors are design.",
  "stacks": [
    {
      "profile-type": "cpu-time",
      "stack-content": [
        {
          "regular_expression": ".*spin",
          "value": 1000000000,
          "error_margin": 8
        }
      ]
    },
    {
      "profile-type": "cpu-time",
      "stack-content": [
        {
          "regular_expression": ".*spin",
          "percent": 12,
          "error_margin": 4,
          "labels": [
            {
              "key": "thread name",
              "values": [
                "spin-0"
              ]
            }
          ]
        }
      ]
    },
    {
      "profile-type": "wall-time",
      "stack-content": [
        {
          "regular_expression": ".*spin",
          "value": 8000000000,
          "error_margin": 8
        }
      ]
    }
  ],
  "scale_by_duration": true
}
