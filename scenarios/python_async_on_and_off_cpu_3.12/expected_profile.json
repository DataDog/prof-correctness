{
  "test_name": "python_async_on_and_off_cpu",
  "note": "on_cpu_task cpu-time share is empirical, not closed form (50 sleepers vs 1×factorial(3500); tick-based profiling attributes most CPU to off_cpu_task). CI hit 11% vs 5±5 (ceiling 10) on main 1898f6e job 106180752136 and PR #216 job 106205139559. ±6 is the smallest band that admits 11%.",
  "stacks": [
    {
      "profile-type": "wall-time",
      "stack-content": [
        {
          "regular_expression2": ".*",
          "regular_expression": ".*main.*off_cpu_task.*",
          "percent": 99,
          "error_margin": 5,
          "labels": [
            {
              "key": "task name",
              "values": [
                "off_cpu_task"
              ]
            }
          ]
        }
      ]
    },
    {
      "profile-type": "cpu-time",
      "stack-content": [
        {
          "regular_expression": ".*main.*on_cpu_task.*",
          "percent": 5,
          "error_margin": 6,
          "labels": [
            {
              "key": "task name",
              "values": [
                "on_cpu_task"
              ]
            }
          ]
        }
      ]
    }
  ],
  "scale_by_duration": false
}
