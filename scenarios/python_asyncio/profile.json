{
  "test_name": "python_asyncio",
  "stacks": [
    {
      "profile-type": "wall-time",
      "stack-content": [
        {
          "regular_expression": ".*my_coroutine.*",
          "percent": 50,
          "error_margin": 100,
          "labels": [
            {
              "key": "thread name",
              "values": [
                "MainThread"
              ]
            },
            {
              "key": "task name",
              "values": [
                "short_task"
              ]
            }
          ]
        }
      ]
    },
    {
      "profile-type": "wall-time",
      "stack-content": [
        {
          "regular_expression": ".*my_coroutine.*",
          "percent": 50,
          "error_margin": 100,
          "labels": [
            {
              "key": "thread name",
              "values": [
                "MainThread"
              ]
            },
            {
              "key": "task name",
              "values_regex": "Task-[0-9]+"
            }
          ]
        }
      ]
    }
  ],
  "scale_by_duration": false
